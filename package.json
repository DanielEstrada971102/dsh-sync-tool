{
  "name": "@local/dsh-sync-tool",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "author": "dsh-sync-tool",
  "description": "Git-based synchronization for global DSH configurations across devices",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/dsh-sync-tool.git"
  },
  "keywords": ["dsh-plugin", "git", "sync", "configuration"],
  "license": "GNU GENERAL PUBLIC LICENSE Version 3"
}